<div class="content-toolbar" style="margin-bottom: 10px;">
    <!-- Buttons will be inserted here by JavaScript -->
</div>
<textarea class="form-control auto-height" data-name="{{name}}" rows="{{rows}}" placeholder="{{translate name category='fields' scope=scope}}" maxlength="{{maxLength}}" autocomplete="espo-{{name}}">{{value}}</textarea>
<div class="text-muted" style="margin-top: 5px;">
    <small>
        Use {{}} for variables, tables with |, and formatting with **, __, etc. Click "Formatting Help" for details.
    </small>
</div>
